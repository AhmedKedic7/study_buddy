# Study Buddy backend configuration.
#
#   cp .env.example .env    # then fill in the values; .env is gitignored
#
# Names use .NET's configuration convention: "__" is a section separator, so
# Llm__ApiKey maps to Llm:ApiKey in appsettings.json. The same names work in .env,
# in docker compose, and as environment variables on your hosting provider.
# Anything left unset falls back to backend/StudyBuddy.Api/appsettings.json.

# --- Required -------------------------------------------------------------------

# LLM API key. Free at https://console.groq.com/keys
Llm__ApiKey=

# Embeddings API key. Free at https://dash.voyageai.com
# (without a payment method Voyage limits you to 3 requests/min; uploads are slower but work)
Voyage__ApiKey=

# --- Optional -------------------------------------------------------------------

# Any OpenAI-compatible chat API works (OpenAI, OpenRouter, local Ollama).
# Llm__BaseUrl=https://api.groq.com/openai/v1
# Llm__Model=openai/gpt-oss-120b

# Any OpenAI-style /embeddings endpoint that returns 1024-dimensional vectors.
# Voyage__BaseUrl=https://api.voyageai.com/v1
# Voyage__Model=voyage-3.5

# PostgreSQL with the pgvector extension. Defaults to the docker compose database.
# Quote it: the value contains semicolons.
# ConnectionStrings__Postgres="Host=localhost;Port=5433;Database=studybuddy;Username=postgres;Password=postgres"

# Frontend origins allowed to call the API (add one line per origin: __0, __1, ...).
# Cors__Origins__0=http://localhost:3000

# Where uploaded PDFs are stored (use a persistent volume in production).
# Storage__UploadPath=data/uploads
